{
  "name": "cloudflare-email-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build && pnpm verify:worker-build",
    "cf:types": "pnpm build && wrangler types --config .output/server/wrangler.json --env-interface CloudflareEnv server/types/cloudflare-env.d.ts",
    "deploy:cloudflare": "node scripts/deploy-cloudflare.mjs",
    "dev": "nuxt dev",
    "db:migrate:local": "wrangler d1 migrations apply DB --local --config .output/server/wrangler.json",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote --config .output/server/wrangler.json",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm cf:types && nuxt typecheck",
    "verify:worker-build": "node scripts/verify-worker-build.mjs",
    "worker:dev": "pnpm build && wrangler dev --config .output/server/wrangler.json"
  },
  "dependencies": {
    "@iconify-json/lucide": "^1.2.117",
    "@nuxt/ui": "^4.10.0",
    "marked": "^17.0.6",
    "nuxt": "^4.5.0",
    "tailwindcss": "^4.3.3",
    "vue": "^3.5.40",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260727.1",
    "@nuxt/eslint": "^1.16.0",
    "@types/node": "^26.2.0",
    "eslint": "^10.7.0",
    "typescript": "^6.0.3",
    "vitest": "latest",
    "vue-tsc": "^3.3.7",
    "wrangler": "^4.114.0"
  },
  "packageManager": "pnpm@11.13.1"
}
