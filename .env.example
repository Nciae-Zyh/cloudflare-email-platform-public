# 所有配置都可省略；下列值是项目内置默认值。
# 只有目标 Worker 不是 cloudflare-email-platform 时才需要 CF_WORKER_NAME。
# CF_WORKER_NAME=cloudflare-email-platform

# 可选：第一次部署时指定自动创建的 D1 名称。
# 省略后 Wrangler 自动创建 cloudflare-email-platform-db。
# CF_D1_DATABASE_NAME=cloudflare-email-platform-db

# 可选运行时变量请直接放在 Worker 的 Variables and Secrets 中。
# SESSION_TTL_SECONDS=28800
